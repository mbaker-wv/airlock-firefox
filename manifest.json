{
  "manifest_version": 2,
  "name": "Hatrack",
  "version": "1.1.0",
  "description": "A different hat for every account. Each new tab gets its own private session, so several accounts on the same site never mix. Close the tab and its login is gone, unless you keep it.",
  "browser_specific_settings": {
    "gecko": {
      "id": "airlock-tabs@addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "browsingData",
    "tabs",
    "menus",
    "privacy",
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Hatrack",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar-dark-16.png",
      "32": "icons/toolbar-dark-32.png",
      "64": "icons/toolbar-dark-64.png"
    },
    "theme_icons": [
      { "light": "icons/toolbar-light-16.png", "dark": "icons/toolbar-dark-16.png", "size": 16 },
      { "light": "icons/toolbar-light-32.png", "dark": "icons/toolbar-dark-32.png", "size": 32 },
      { "light": "icons/toolbar-light-64.png", "dark": "icons/toolbar-dark-64.png", "size": 64 }
    ]
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "commands": {
    "new-tab-same-session": {
      "suggested_key": { "default": "Ctrl+Alt+T" },
      "description": "New tab in the same hat"
    }
  }
}
